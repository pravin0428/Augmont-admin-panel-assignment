# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:4200

# ─── Database (PostgreSQL) ────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_db?schema=public

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# ─── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=2097152        # 2 MB
BULK_IMPORT_BATCH_SIZE=500          # rows per DB insert batch

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000         # 15 minutes
RATE_LIMIT_MAX=300                  # requests per window per IP

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
